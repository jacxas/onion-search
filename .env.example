# ── base de datos ───────────────────────────────────────────────────────
# (.env ya está en .gitignore — no lo comitees)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── modo del crawler ────────────────────────────────────────────────────
# live = crawler real a través del proxy SOCKS5 de Tor
# sim  = red onion simulada determinista (desarrollo/preview)
CRAWL_MODE=sim

# proxy Tor (solo en modo live). socks5h = DNS remoto, obligatorio para .onion
# vale cualquiera de los dos formatos:
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
# TOR_SOCKS_HOST=127.0.0.1
# TOR_SOCKS_PORT=9050

# semillas iniciales para modo live (separadas por coma o espacio)
TOR_SEED_URLS=

# ── seguridad / acceso admin ────────────────────────────────────────────
# admin inicial (se crea SOLO en el primer arranque; luego la auth vive en la
# DB con hash scrypt). En NODE_ENV=production son OBLIGATORIAS y la contraseña
# no puede ser una default/conocida (SEC-01). En desarrollo valen los defaults.
ADMIN_INITIAL_EMAIL=admin@faro.local
ADMIN_INITIAL_PASSWORD=faro-admin-123

# token para /api/admin/run desde cron/server-to-server.
# si no se define, ese endpoint exige sesión de admin (login en /login).
ADMIN_TOKEN=

# CSRF: validación de Origin same-origin en endpoints autenticados por cookie
# (las server actions ya traen validación de Origin incorporada en Next)
CSRF_ENABLED=true
# true solo en producción detrás de HTTPS (o tu .onion con TLS)
SECURE_COOKIES=false

# Nota: no hace falta SECRET_KEY — las sesiones son tokens aleatorios de
# 256 bits y en la DB solo se guarda su hash SHA-256.

# ── alertas por email (opcional) ────────────────────────────────────────
# Gmail: NO tu password real — generar un App Password en
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ALERT_TO=
# SMTP genérico (opcional; sin MAIL_HOST usa service:gmail)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587

# ── worker (WORK-01) ──
# Sin WORKER_INTERVAL_SECONDS el worker es one-shot (un ciclo y sale).
# Con ella, cicla: seed → crawl → health → sleep → repeat (shutdown SIGTERM).
# WORKER_INTERVAL_SECONDS=900
WORKER_MAX_PAGES=60
WORKER_HEALTH_LIMIT=40

# ── parámetros del pipeline ─────────────────────────────────────────────
CRAWL_MAX_DEPTH=2
CRAWL_DOMAIN_CAP=12
CRAWL_TIMEOUT_MS=30000
HEALTH_TIMEOUT_MS=20000
HEALTH_INTERVAL_MIN=45
