# ConfiguraciÃ³n para Onion Search Engine

# Tor
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# Meilisearch
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=dev-master-key-change-in-prod

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@db:5432/onion_search
DB_PASSWORD=postgres

# Crawler
CRAWLER_CONCURRENCY=2
CRAWLER_TIMEOUT=30
CRAWLER_MAX_PAGES=1000

# Health checker
HEALTH_CHECK_INTERVAL=3600
HEALTH_CHECK_TIMEOUT=15

# Admin dashboard
ADMIN_TOKEN=change-this-to-a-secure-token
