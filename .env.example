# ── base de datos ───────────────────────────────────────────────────────
# sin DATABASE_URL: SQLite local en ./faro.db (desarrollo)
# DATABASE_URL=postgresql+psycopg2://faro:faro@127.0.0.1:5432/faro

# ── índice de búsqueda (opcional) ───────────────────────────────────────
# si Meilisearch no responde, FARO usa el motor local
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=dev-master-key
# MEILI_TIMEOUT=2

# ── modo del crawler ────────────────────────────────────────────────────
# sim = datos sintéticos deterministas (desarrollo/preview)
# live = rastreo real por el proxy SOCKS5 de Tor
CRAWL_MODE=sim
# FARO_SEED=1        # 0 desactiva la semilla demo

# proxy Tor (solo en modo live). socks5h = DNS remoto, obligatorio para .onion
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
# TOR_SOCKS_HOST=127.0.0.1
# TOR_SOCKS_PORT=9050
# semillas iniciales para modo live (separadas por coma)
TOR_SEED_URLS=

# ── acceso al centro de mando (/admin/login) ────────────────────────────
ADMIN_TOKEN=admin-secret-token
# true solo en producción con HTTPS/TLS sobre el onion
SECURE_COOKIES=false

# ── alertas por email (opcional, usado por health_checker) ──────────────
# Gmail: usar App Password, nunca la contraseña real
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ALERT_TO=
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587

# ── parámetros del pipeline de rastreo ──────────────────────────────────
CRAWL_MAX_DEPTH=2
CRAWL_DOMAIN_CAP=12
CRAWL_TIMEOUT_MS=30000
HEALTH_TIMEOUT_MS=20000
HEALTH_INTERVAL_MIN=45
