# Frontend Next.js - Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=masterKey

# Tor Configuration
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_SOCKS_PROXY=127.0.0.1:9050

# Security
SECRET_KEY=generate-with-python-secrets-token-urlsafe-32
CSRF_ENABLED=true
SECURE_COOKIES=false

# Crawler
ENABLE_CRAWLER=true
CRAWLER_INTERVAL_MS=60000
HEALTH_CHECK_INTERVAL_MS=900000
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_CONCURRENT=2
CRAWLER_TIMEOUT_MS=30000
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_BATCH_SIZE=10

# Seed URLs (comma-separated .onion addresses)
SEED_URLS=tor66sewebgixwhcqfnp5inzp5x5uohhdy3kvtnyfxc2e5mxiuh34iid.onion

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Admin (optional - for API key auth)
ADMIN_API_KEY=
